{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prophet evidence item",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim",
    "system",
    "json_paths",
    "school",
    "rule_id",
    "corpus_reference",
    "confidence",
    "counter_interpretation"
  ],
  "properties": {
    "claim": {
      "type": "string",
      "pattern": "\\S"
    },
    "school": {
      "type": "string",
      "pattern": "\\S"
    },
    "rule_id": {
      "type": "string",
      "pattern": "\\S"
    },
    "counter_interpretation": {
      "type": "string",
      "pattern": "\\S"
    },
    "system": {
      "enum": [
        "bazi",
        "ziwei",
        "western",
        "vedic",
        "liuyao",
        "meihua",
        "qimen",
        "huangli",
        "tarot"
      ]
    },
    "json_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^\\$(?:\\.[A-Za-z_\\u0080-\\uffff][\\w\\u0080-\\uffff-]*|\\[(?:0|[1-9][0-9]*)\\]|\\[\"(?:[^\"\\\\]|\\\\.)*\"\\])+$"
      }
    },
    "corpus_reference": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "\\S"
        },
        "query": {
          "type": "string",
          "pattern": "\\S"
        }
      }
    },
    "confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    }
  }
}
